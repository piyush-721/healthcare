# Copy to .env and adjust. Never commit .env.
# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Separate key for signing access tokens (defaults to DJANGO_SECRET_KEY).
AUTH_JWT_SIGNING_KEY=
# Set to true whenever the site is served over HTTPS.
AUTH_COOKIE_SECURE=false

# ---- Data stores ----
DATABASE_URL=postgres://healthos:healthos@localhost:5434/healthos
REDIS_URL=redis://localhost:6380/0

# ---- Frontend / CORS ----
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# ---- Email (Mailpit in development) ----
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=HealthOS <no-reply@healthos.local>

# ---- Files ----
PRIVATE_STORAGE_ROOT=./backend/private_storage
MAX_UPLOAD_SIZE_MB=15

# ---- Celery ----
# true runs tasks inline (no worker needed) — handy for quick local runs.
CELERY_TASK_ALWAYS_EAGER=false

# ---- Frontend (Next.js) ----
# Where the Next.js server proxies /api/* requests.
BACKEND_ORIGIN=http://localhost:8000

# ---- Vercel (see docs/deployment/vercel.md) ----
# Provisioned by integrations: DATABASE_URL (Neon), BLOB_READ_WRITE_TOKEN (private Blob store),
# optional REDIS_URL (Upstash). Set yourself: DJANGO_SECRET_KEY, CRON_SECRET, SMTP settings.
# CRON_SECRET=
# EMAIL_USE_SSL=false
# HEALTHOS_SEED_DEMO=1
# SKIP_MIGRATIONS=1
